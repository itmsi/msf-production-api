    "version": "0.2.0",
    "configurations": [
        {
           "type": "node",
            "request": "launch",
            "name": "TID Project Dev",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "console": "integratedTerminal",
            "autoAttachChildProcesses": true,
            "cwd": "${workspaceFolder}",
            "restart": true,
            "sourceMaps": true,
            "skipFiles": ["<node_internals>/**"],
        }
    ]
}